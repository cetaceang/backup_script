# OpenList service address, without a trailing slash.
OPENLIST_URL="https://openlist.example.com"

# OpenList API token. Keep the real .env file at mode 600.
OPENLIST_TOKEN="replace-with-your-token"

# Existing destination directory in OpenList. The script will append the
# generated archive filename and will not overwrite an existing remote file.
OPENLIST_REMOTE_DIR="/backups/my-server"

# Absolute local directories to include, one per line. Blank lines are ignored.
# Keep the opening and closing quotes on their own lines as shown here.
SOURCE_DIRS="
/etc
/var/lib/my-application
"

# Local staging directory. It must not be inside any source directory.
WORK_DIR="/var/tmp/openlist-backup"
